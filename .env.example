# LLM Configuration
# Supports OpenRouter, OpenAI, Anthropic, Gemini (via OpenAI compatible endpoint), Ollama, vLLM

# Default provider endpoint and key (e.g., OpenRouter or OpenAI)
OPENAI_API_BASE=https://openrouter.ai/api/v1
OPENAI_API_KEY=your_api_key_here

# Model identifier
NOLTHIRA_MODEL=nousresearch/hermes-3-llama-3.1-405b:free

# Agent Settings
NOLTHIRA_TEMPERATURE=0.2
NOLTHIRA_MAX_STEPS=25
NOLTHIRA_MEMORY_DB=nolthira_memory.db
NOLTHIRA_AUTO_APPROVE=false

# Messaging Gateways (Hermes-Style Telegram, Discord, WhatsApp)
GATEWAY_ALLOW_ALL_USERS=false
GATEWAY_AUTO_START=false

# Telegram Bot (@BotFather)
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_USERS=

# Discord Bot (Developer Portal)
DISCORD_BOT_TOKEN=
DISCORD_ALLOWED_USERS=
DISCORD_ALLOWED_CHANNELS=

# WhatsApp (Local Baileys/Evolution Bridge OR Meta Cloud API)
WHATSAPP_ENABLED=false
WHATSAPP_PORT=8090
WHATSAPP_ALLOWED_NUMBERS=
WHATSAPP_BRIDGE_URL=
WHATSAPP_BRIDGE_TOKEN=
WHATSAPP_API_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=replace_with_a_long_random_verify_token
# Required for Meta Cloud API webhook authenticity checks
WHATSAPP_APP_SECRET=
WHATSAPP_REQUIRE_SIGNATURE=true
